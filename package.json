    "env:production": "node scripts/print-production-env-template.mjs",
    "env:pull:production": "npx vercel env pull .env.production --environment=production --yes",
    "env:check": "node scripts/verify-production-env.mjs",
    "env:check:launch": "node scripts/verify-production-env.mjs --launch",
    "env:repair": "node scripts/print-vercel-env-repair-plan.mjs",
    "env:vercel": "node scripts/verify-vercel-env-names.mjs production",
    "env:vercel:launch": "npm run env:pull:production && npm run env:vercel && npm run env:check:launch",
    "launch:production": "node scripts/run-production-launch.mjs",
