{
  "name": "returnpick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-brace-expansion-compat.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "git:check": "node scripts/verify-git-deploy-readiness.mjs",
    "check:readiness": "node scripts/check-readiness.mjs",
    "check:launch": "node scripts/check-readiness.mjs --launch",
    "check:production": "node scripts/verify-production-readiness.mjs",
    "check:production:launch": "node scripts/verify-production-readiness.mjs --launch",
    "env:production": "node scripts/print-production-env-template.mjs",
    "env:pull:production": "npx vercel env pull .env.production --environment=production --yes",
    "env:check": "node scripts/verify-production-env.mjs",
    "env:bootstrap:check": "node scripts/verify-production-env.mjs --self-test-bootstrap-catalog",
    "env:check:launch": "node scripts/verify-production-env.mjs --launch",
    "env:repair": "node scripts/print-vercel-env-repair-plan.mjs",
    "env:vercel": "node scripts/verify-vercel-env-names.mjs production",
    "env:vercel:launch": "npm run env:pull:production && npm run env:vercel && npm run env:check:launch",
    "launch:production": "node scripts/run-production-launch.mjs",
    "scheduler:check": "node scripts/verify-github-hourly-scheduler.mjs",
    "affiliate-backfill:check": "node scripts/verify-scheduled-affiliate-backfill.mjs",
    "scoring:check": "node scripts/verify-scoring-rules.mjs",
    "search-intent:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-search-intent-landings.mjs",
    "home-purpose:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-home-purpose-selection.mjs",
    "freshness:check": "node scripts/verify-deal-freshness.mjs",
    "discovery-updates:check": "node scripts/verify-discovery-updates.mjs",
    "manual-import:check": "node scripts/verify-manual-import-safety.mjs",
    "affiliate-identity:check": "node scripts/verify-affiliate-identity.mjs",
    "affiliate-link-intake:check": "node scripts/verify-affiliate-link-intake.mjs",
    "affiliate-link-intake-bulk:check": "node scripts/verify-affiliate-link-intake-bulk.mjs",
    "bootstrap-catalog:check": "node scripts/verify-bootstrap-catalog-runtime.mjs",
    "demo-catalog:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-demo-catalog-stability.mjs",
    "supabase-config:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-supabase-config-guard.mjs",
    "content-kit:check": "node scripts/verify-product-distribution-kit.mjs",
    "launch-capabilities:check": "node scripts/verify-launch-capability-policy.mjs",
    "naver-match:check": "node scripts/verify-naver-product-match.mjs",
    "naver-price-trust:check": "node scripts/verify-naver-price-trust.mjs",
    "coupang-provider:check": "node scripts/verify-coupang-provider.mjs",
    "provider-merge:check": "node scripts/verify-provider-product-merge.mjs",
    "public-web:check": "node scripts/verify-public-web-config.mjs",
    "web-return:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-web-return-info.mjs",
    "public-web-url:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-public-web-url-safety.mjs",
    "public-web-detail:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-public-web-detail-enrichment.mjs",
    "public-web-jsonld:check": "node scripts/verify-public-web-jsonld.mjs",
    "schema:setup": "node scripts/print-supabase-setup-runbook.mjs",
    "schema:production": "node scripts/verify-supabase-schema.mjs",
    "sourcing:diagnose": "node scripts/diagnose-sourcing-recovery.mjs",
    "sourcing:throughput:check": "node scripts/verify-sourcing-throughput.mjs",
    "doctor:production": "node scripts/run-production-doctor.mjs",
    "doctor:production:launch": "node scripts/run-production-doctor.mjs --launch",
    "doctor:production:fresh": "npm run env:pull:production && npm run env:vercel && npm run doctor:production",
    "doctor:production:launch:fresh": "npm run env:pull:production && npm run env:vercel && npm run env:check:launch && npm run doctor:production:launch",
    "deploy:production:launch": "node scripts/run-production-deploy.mjs",
    "deploy:production:go-live": "node scripts/run-production-deploy.mjs --first-launch"
