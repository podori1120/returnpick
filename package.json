  "dependencies": {
    "@supabase/supabase-js": "2.105.4",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.18",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
